const PDFDocument = require("pdfkit");
const fs = require("fs");
const path = require("path");

function safe(value, fallback = "") {
  return String(value ?? fallback).trim();
}

function addPageNumber(doc, number) {
  doc.fontSize(9)
    .fillColor("#64748b")
    .text(String(number), 0, 790, {
      align: "center",
      width: 595
    });
}

