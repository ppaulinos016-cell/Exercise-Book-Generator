      safe(book.title, "English Exercise Book"),
      55,
      170,
      {
        align: "center",
        width: 485
      }
    );

  doc.fillColor("#2563eb")
    .fontSize(25)
    .text(
      safe(book.className, "Class 1"),
      55,
      270,
      {
        align: "center",
        width: 485
      }
    );

  doc.fillColor("#111827")
    .fontSize(19)
    .text("English", 55, 320, {
      align: "center",
      width: 485
    });

  doc.fontSize(75)
    .text("📚", 55, 400, {
      align: "center",
      width: 485
    });

  doc.fillColor("#374151")
    .fontSize(15)
    .text(
      safe(book.subtitle, "Practice and Activities"),
      55,
      515,
      {
        align: "center",
        width: 485
      }
    );

  doc.fontSize(14)
    .text(
      `Author: ${safe(book.author, "Author")}`,
      55,
      650,
      {
        align: "center",
        width: 485
      }
    );

  doc.fontSize(12)
    .text(
      `${safe(book.edition, "First Edition")} • ${safe(book.year, "2026")}`,
      55,
      690,
      {
        align: "center",
        width: 485
      }
    );
}

