function addHowToUsePage(doc) {
  doc.addPage();

  doc.fillColor("#111827")
    .fontSize(27)
    .text("How to Use This Book", 60, 70);

  doc.moveTo(60, 110)
    .lineTo(535, 110)
    .stroke("#2563eb");

  const guidance = [
    "1. Follow the lesson carefully in class.",
    "2. Listen to your teacher and understand the lesson before using this exercise book.",
    "3. After the lesson, open the corresponding unit in this book.",
    "4. Read the instructions carefully before completing each exercise.",
    "5. Work independently and write your answers clearly.",
    "6. Ask your teacher for help when you do not understand an activity."
  ];

  let y = 150;

  guidance.forEach(item => {
    doc.fontSize(14)
      .fillColor("#374151")
      .text(item, 65, y, {
        width: 465,
        lineGap: 7
      });

    y += 62;
  });

  doc.fontSize(14)
    .fillColor("#1e3a8a")
    .text(
      "Remember: this exercise book is for practice. The lesson should come first.",
      65,
      y + 15,
      {
        width: 465,
        lineGap: 7
      }
    );
}

function addTableOfContents(doc, units) {
  doc.addPage();

  doc.fillColor("#111827")
    .fontSize(27)
    .text("Table of Contents", 60, 70);

  doc.moveTo(60, 110)
    .lineTo(535, 110)
    .stroke("#2563eb");

  let y = 145;

  units.forEach((unit, index) => {
    doc.fontSize(14)
      .fillColor("#374151")
      .text(
        `Unit ${index + 1}: ${safe(unit.title, "Untitled Unit")}`,
        70,
        y,
        {
          width: 450
        }
      );

    y += 30;

    if (y > 740) {
      addPageNumber(doc, index + 1);
      doc.addPage();
      y = 70;
    }
  });
}

function addUnit(doc, unit) {
  doc.addPage();

  doc.fillColor("#1e3a8a")
    .fontSize(28)
    .text(`Unit ${safe(unit.number, "")}`, 60, 65);

  doc.fillColor("#111827")
    .fontSize(22)
    .text(
      safe(unit.title, "Untitled Unit"),
      60,
      105,
      {
        width: 475
      }
    );

  if (safe(unit.description)) {
    doc.fillColor("#64748b")
      .fontSize(12)
      .text(
        safe(unit.description),
        60,
        145,
        {
          width: 475,
          lineGap: 5
        }
      );
  }

  let y = safe(unit.description) ? 200 : 165;

  (unit.exercises || []).forEach((exercise, index) => {
    if (y > 690) {
      doc.addPage();
      y = 65;
    }

    doc.fillColor("#2563eb")
      .fontSize(17)
      .text(
        `Exercise ${index + 1}: ${safe(exercise.title, "Exercise")}`,
        60,
        y,
        {
          width: 475
        }
      );

    y += 28;

    if (safe(exercise.instructions)) {
      doc.fillColor("#374151")
        .fontSize(11)
        .text(
          safe(exercise.instructions),
          65,
          y,
          {
            width: 465,
            lineGap: 4
          }
        );

      y += 32;
    }

    if (safe(exercise.content)) {
      doc.fillColor("#111827")
        .fontSize(12)
        .text(
          safe(exercise.content),
          65,
          y,
          {
            width: 465,
            lineGap: 6
          }
        );

      y += 70;
    } else {
      y += 30;
    }

    doc.moveTo(65, y)
      .lineTo(530, y)
      .stroke("#e2e8f0");

    y += 25;
  });
}

function addFinalPage(doc) {
  doc.addPage();

  doc.fillColor("#1e3a8a")
